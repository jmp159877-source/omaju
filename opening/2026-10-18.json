  "morning": {
   "audio": "2026-10-18-morning.mp3",
   "end": 80.43,
   "segs": [
    {
     "t": 0.0,
     "tag": "wave",
     "cap": [
      "좋은 아침입니다\n미소입니다"
     ]
    },
    {
     "t": 2.67,
     "tag": "stand",
     "cap": [
      "일요일 아침, 새 운동화",
      "끈을 묶어보기 좋은 날씨네요"
     ]
    },
    {
     "t": 9.23,
     "tag": "read",
     "cap": [
      "오늘 사연은 53세\n지연 씨의 이야기입니다"
     ]
    },
    {
     "t": 13.51,
     "tag": "moved",
     "cap": [
      "주말 새벽 첫차로 다니는\n스페인어 학원",
      "석 달째 되니\n너무 지쳤대요"
     ]
    },
    {
     "t": 20.25,
     "tag": "surprise",
     "cap": [
      "'오늘이 마지막'이라\n결심하고 탔는데",
      "맞은편 남자가 졸다가\n가방을 쏟았답니다"
     ]
    },
    {
     "t": 27.47,
     "tag": "laugh",
     "cap": [
      "바닥에 흩어진 책을\n주워주는데, 어머나",
      "지연 씨랑 똑같은\n왕초보 단어장이었죠"
     ]
    },
    {
     "t": 34.5,
     "tag": "talk",
     "cap": [
      "\"동사 변형 진짜\n안 외워지죠?\"",
      "지연 씨 물음에\n남자가 쑥스럽게 웃었대요"
     ]
    },
    {
     "t": 41.51,
     "tag": "read",
     "cap": [
      "\"네, 석 달째\n이 차 타고 가는데\"",
      "\"사실 매일\n포기하고 싶네요\""
     ]
    },
    {
     "t": 47.02,
     "tag": "laugh",
     "cap": [
      "알고 보니 같은 반이었대요",
      "늘 뒷자리에만 앉아서\n서로 얼굴을 몰랐던 거죠"
     ]
    },
    {
     "t": 54.51,
     "tag": "delight",
     "cap": [
      "두 사람은 다음 주에도\n새벽 첫차에서",
      "같은 칸에 타기로\n약속했답니다"
     ]
    },
    {
     "t": 60.16,
     "tag": "moved",
     "cap": [
      "포기하려던 길에서 마주친\n다정한 미소가",
      "다시 학원으로 이끄는\n설렘이 된 거죠"
     ]
    },
    {
     "t": 66.68,
     "tag": "talk",
     "cap": [
      "혼자라면 멈췄을 길도",
      "나란히 걷는 사람이 생기면\n조금 더 가보고 싶어지잖아요"
     ]
    },
    {
     "t": 72.82,
     "tag": "smile",
     "cap": [
      "맑은 일요일, 기분 좋은\n설렘이 가득한 하루 보내세요"
     ]
    },
    {
     "t": 77.24,
     "tag": "thumb",
     "cap": [
      "내일은 한결 씨가\n새 사연을 가져옵니다."
     ]
    }
   ]
  },
