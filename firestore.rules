rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    function notBanned() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.get('banned', false) != true; }
    function onlyIncrement(field) {
      return request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasOnly([field])
        && request.resource.data[field] == (resource == null ? 0 : resource.data.get(field, 0)) + 1;
    }

    // 회원: 본인과 관리자만 읽고, 본인만 쓴다. 역할(role)은 본인이 못 바꾼다.
    match /users/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create: if isMe(uid) && request.resource.data.role == 'member';
      allow update: if (isMe(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'username', 'banned', 'phone', 'founderNo', 'noFounder'])) || isAdmin();
      allow delete: if isAdmin();
    }
    // 아이디·별명 중복 확인: 누구나 있는지 볼 수 있고, 비어 있을 때만 본인이 만든다.
    match /usernames/{name} {
      allow get: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }
    match /nicknames/{key} {
      allow get: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }
    // 출석: 본인 것만, 하루 한 번(문서 id가 uid_날짜라 중복 불가).
    match /checkins/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && id == request.auth.uid + '_' + request.resource.data.date;
    }
    // 오늘 콘텐츠·공지: 누구나 읽고, 관리자만 쓴다.
    match /daily/{date} { allow read: if true; allow write: if isAdmin(); }
    match /notices/{id} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }
    // 투표: 누구나 읽고, 한 칸을 1씩만 올릴 수 있다. 회원은 votes로 한 번만.
    match /polls/{date} {
      allow read: if true;
      allow create: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counts']) || isAdmin();
    }
    match /votes/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && id == request.resource.data.date + '_' + request.auth.uid;
    }
    // 한마디: 숨겨지지 않은 것은 누구나 읽고, 회원만 쓰고, 본인 것만 지운다. 신고 수는 1씩만.
    match /comments/{id} {
      allow read: if resource.data.hidden == false || isAdmin();
      allow create: if signedIn() && notBanned() && request.resource.data.uid == request.auth.uid && request.resource.data.text.size() <= 200 && request.resource.data.hidden == false && request.resource.data.reports == 0;
      allow update: if (signedIn() && onlyIncrement('reports')) || isAdmin();
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // 오프닝 사연: 회원이 보내고, 관리자만 읽고 고친다.
    match /stories/{id} {
      allow create: if signedIn() && notBanned() && request.resource.data.uid == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() >= 10 && request.resource.data.text.size() <= 1000 && request.resource.data.status == 'new';
      allow read, update, delete: if isAdmin();
    }

    // 나의 수첩: 본인 것만 읽고 쓰고 지운다 (관리자도 못 본다)
    match /notes/{id} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && notBanned() && request.resource.data.uid == request.auth.uid && request.resource.data.text.size() <= 2000;
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid && request.resource.data.text.size() <= 2000;
    }
    // 담아 두기: 본인 것만 읽고 쓰고 지운다 (관리자도 못 본다)
    match /saves/{id} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn() && notBanned() && request.resource.data.uid == request.auth.uid
        && id.matches('^' + request.auth.uid + '__.*') && request.resource.data.title is string && request.resource.data.title.size() <= 200;
    }
    match /reports/{id} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && id.matches('^.*_' + request.auth.uid + '$');
    }
    // 아이디·비밀번호 찾기 요청: 누구나 넣고, 관리자만 본다.
    match /resets/{id} { allow create: if true; allow read, update, delete: if isAdmin(); }
    // 오늘 PLAY 순위: 누구나 보고, 본인 기록만 더 좋은 기록으로 고친다.
    match /scores/{k}/e/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && notBanned() && uid == request.auth.uid
        && k.matches('^(malmoi|shisen|num50|sudoku)_[0-9]{4}(W[0-9]{2}|[0-9]{4})$')
        && request.resource.data.keys().hasOnly(['uid', 'nick', 'score', 'label', 'at'])
        && request.resource.data.uid == uid
        && request.resource.data.nick is string && request.resource.data.nick.size() <= 20
        && request.resource.data.label is string && request.resource.data.label.size() <= 30
        && request.resource.data.score is number && request.resource.data.score >= 3000
        && (resource == null || request.resource.data.score < resource.data.score);
    }
    // 아침 알림 받기: 누구나 자기 기기를 등록·해지. 읽기는 서버(관리 계정)만.
    match /push/{id} {
      allow create, update: if request.resource.data.keys().hasOnly(['token', 'hour', 'ua', 'updated', 'uid'])
        && request.resource.data.token is string && request.resource.data.token.size() < 500
        && request.resource.data.hour in [7, 8, 9];
      allow delete: if true;
      allow read: if isAdmin();
    }
    // 집계: 숫자만 올릴 수 있고, 관리자만 본다.
    match /stats/{date} {
      allow read: if isAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(['visits', 'clicks', 'newDevices', 'blog']);
    }
  }
}
